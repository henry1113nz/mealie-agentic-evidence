+    indexes = await db.execute_query_dict(f'PRAGMA index_list("{table}")')
+    unique_tuples = set()
+    for index in indexes:
+        if index["unique"]:
+            columns = await db.execute_query_dict(f'PRAGMA index_info("{index["name"]}")')
