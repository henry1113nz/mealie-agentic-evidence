+        ("  " + "É" * 300, "e" * 255),
+    ],
+)
+def test_normalization_preserves_search_and_legacy_storage(value: str, expected: str) -> None:
+    assert TortoiseBase.normalize(value) == expected
+    assert TortoiseBase.normalize(value) == SqlAlchemyBase.normalize(value)
+
