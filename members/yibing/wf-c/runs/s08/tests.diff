+def populate_group_slugs(session: Session):
+    groups: list[Group] = session.query(Group).all()
+    seen_slugs: set[str] = set()
+    for group in groups:
+        original_name = group.name
+        new_name = original_name
+        attempts = 0
+        while True:
+            slug = slugify(new_name)
+            if slug not in seen_slugs:
