+    ambiguous: set[str] = set()
+
+    for path in locales_dir.glob("*.json"):
+        try:
+            translations = json.loads(path.read_text(encoding="utf-8")).get("datetime") or {}
+        except OSError, ValueError, AttributeError:
+            continue
