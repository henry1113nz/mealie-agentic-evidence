+    restored = cleared = 0
+    for recipe_id, image in rows:
+        has_image = on_disk[str(recipe_id)]
+
+        if has_image and (not image or image == NO_IMAGE):
+            session.execute(
+                text("UPDATE recipes SET image = :image WHERE id = :id"),
+                {"image": cache.new_key(4), "id": recipe_id},
+            )
+            restored += 1
