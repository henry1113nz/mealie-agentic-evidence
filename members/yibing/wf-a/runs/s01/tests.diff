+        for unit in UNIT_SECONDS:
+            for word in str(translations.get(unit) or "").split("|"):
+                if not (word := word.strip().casefold()):
+                    continue
+                if words.setdefault(word, unit) != unit:
+                    ambiguous.add(word)
