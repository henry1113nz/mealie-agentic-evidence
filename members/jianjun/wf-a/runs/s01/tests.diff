+            return None
+
+        unit = unit_words[m.group(2)]
+        order = list(UNIT_SECONDS)
+        if seen_units and order.index(unit) <= order.index(seen_units[-1]):
+            return None
+
+        seen_units.append(unit)
+        total += Decimal(m.group(1)) * UNIT_SECONDS[unit]
