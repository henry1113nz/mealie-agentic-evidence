+
+MAX_SECONDS = 2**31 - 1
+"""Postgres INTEGER max"""
+
+TIME_FIELDS = ("total_time", "prep_time", "perform_time")
+
+UNIT_SECONDS = {"day": 86400, "hour": 3600, "minute": 60, "second": 1}
+"""Largest first; components must appear in this order, each at most once"""
